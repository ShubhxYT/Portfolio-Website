{
  "name": "portfolio",
  "main": "worker/chat.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Non-secret vars and bindings must be declared here. Cloudflare Workers
  // Builds (GitHub git integration on this repo) runs `wrangler deploy` on
  // push to main, which deletes undeclared plain-text vars. Do not put
  // secrets or HERMES_URL in this file; HERMES_URL is a Worker secret.
  "vars": {
    "CHAT_ENABLED": "true",
    "TRANSPORT": "vpc"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "923073",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "vpc_services": [
    {
      "binding": "HERMES_VPC",
      "service_id": "01a1a63f-97c2-71a1-8d80-f4c411ec12af"
    }
  ]
}
